# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
WEB_VIRTUAL_PORT=8123
WEB_VIRTUAL_HOST=clickhouse-example.com

API_VIRTUAL_PORT=9000
API_VIRTUAL_HOST=api.clickhouse-example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=clickhouse-example.com,api.clickhouse-example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com