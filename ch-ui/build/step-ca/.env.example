# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=ch-ui

# Docker image
IMAGE=ghcr.io/caioricciuti/ch-ui:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

CLICKHOUSE_URL=http://host.docker.internal:8123

APP_SECRET_KEY=sDrrQCHzCloTYKUswZLesumUqd3L8uVw
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=3488
VIRTUAL_HOST=ch-ui.local

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=ch-ui.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com

APP_URL=https://${VIRTUAL_HOST}

ALLOWED_ORIGINS=https://${VIRTUAL_HOST}
#Step CA Trust
STEP_CA_TRUST=true
STEP_CA_TRUST_RESTART=true